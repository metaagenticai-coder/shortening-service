# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Go workspace file
go.work
go.work.sum

# Build artifacts
/bin/
/dist/
/build/

# Environment variables
.env
.env.local
.env.*.local

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Dependency directories
vendor/

# Temporary files
tmp/
temp/

# Logs
*.log
logs/

# Database files
*.db
*.sqlite
*.sqlite3

# Configuration files with sensitive data
configs/*.local.yaml
configs/*.secret.yaml

# GCP credentials
*-credentials.json
service-account-key.json

# Testing
.testcache/

# Cloud Run specific
.gcloudignore

# Debug
__debug_bin

# Air (live reload) temporary files
tmp/
