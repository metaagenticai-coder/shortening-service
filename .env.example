# Shortening Service Configuration
PORT=8080
DATABASE_URL=postgres://shortener:password@localhost:5432/url_shortener?sslmode=disable
REDIS_URL=redis://:password@localhost:6379/0
SHORT_DOMAIN=short.link
LOG_LEVEL=info
RATE_LIMIT_PER_IP=100
WORKER_ID=auto
ENVIRONMENT=development

# Redirect Service Configuration (if running separately)
# PORT=8081
# DATABASE_URL=postgres://shortener:password@localhost:5432/url_shortener?sslmode=disable
# REDIS_URL=redis://:password@localhost:6379/0
# CACHE_TTL=3600
# LOG_LEVEL=info

# GCP Project Configuration (for deployment)
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
